# Stage 1: Build Rust binary
FROM rust:1-slim-bookworm AS builder

WORKDIR /usr/src/shieldpay

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY backend/Cargo.toml backend/Cargo.toml
COPY backend/app backend/app

RUN cargo build --release -p shieldpay-core

# Stage 2: Minimal runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/shieldpay/target/release/shieldpay-core /usr/local/bin/shieldpay-core

EXPOSE 8080

ENV PORT=8080
ENV DATABASE_URL=/data/shieldpay.db
ENV HMAC_SECRET=dev-secret-key
ENV COOLING_SECONDS=20
ENV RISK_ENGINE_URL=http://risk-ai:8000

VOLUME ["/data"]

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["shieldpay-core"]
